# Copy this file to .env.local and fill in real values.
# Required at runtime; the app will refuse to start without them.

# --- Session ----------------------------------------------------------------
# 32+ random characters. Generate with: openssl rand -hex 32
SESSION_SECRET=

# --- Dashboard authentication ----------------------------------------------
# Password used to log into /miniapp via the password fallback.
DASHBOARD_PASSWORD=

# --- Database ---------------------------------------------------------------
# PostgreSQL connection string for the dashboard database.
DATABASE_URL=postgresql://user:password@localhost:5432/kama_dashboard

# --- Telegram (optional, used by the mini-app) -----------------------------
# BotFather token (123456:ABC-DEF...)
TELEGRAM_BOT_TOKEN=
# Your numeric Telegram user ID — only this user can sign in via Telegram.
OWNER_TELEGRAM_ID=
# Shared secret added to the Telegram webhook URL to authenticate inbound updates.
TELEGRAM_WEBHOOK_SECRET=

# --- Resend (transactional email) ------------------------------------------
RESEND_API_KEY=

# --- Anthropic (Claude) -----------------------------------------------------
ANTHROPIC_API_KEY=
# Optional override; falls back to claude-sonnet-4-6
# ANTHROPIC_MODEL=claude-sonnet-4-6
